# Main LLM profile. Non-secret model metadata lives in config/model_profiles.json.
# Keep .env focused on secrets and local runtime switches.
PRINCIPIA_MODEL_PROFILE=deepseek_v4_flash

# Provider API keys used by config/model_profiles.json.
DEEPSEEK_API_KEY=your-deepseek-api-key
DASHSCOPE_API_KEY=your-dashscope-api-key
MINIMAX_API_KEY=your-minimax-api-key
ZHIPUAI_API_KEY=your-zhipuai-api-key
OPENAI_API_KEY=your-openai-api-key

# Retrieval can use a separate cheaper model. Empty values fall back to main LLM.
RETRIEVAL_LLM_ACTIVE_PROFILE=
RETRIEVAL_LLM_PROVIDER=
RETRIEVAL_LLM_API_KEY=
RETRIEVAL_LLM_MODEL=
RETRIEVAL_LLM_API_BASE_URL=

# Domain data.
BLASTFOAM_TUTORIALS=/data/graduation-projects/blastFoam_tutorials

# Execution controls.
ENABLE_EXECUTION=false
REQUIRE_EXECUTION=false
ALLOW_ROOT_OPENFOAM=false
OPENFOAM_EXECUTION_USER=openfoam
OPENFOAM_CHOWN_CASE=true
OPENFOAM_BASHRC=/data/OpenFOAM/OpenFOAM-9/etc/bashrc
BLASTFOAM_BASHRC=/data/OpenFOAM/blastfoam/etc/bashrc

# Agent controls.
DEEPAGENTS_RECURSION_LIMIT=200
MCP_RETRIEVAL_TIMEOUT_SECONDS=120
MCP_RETRIEVAL_STARTUP_TIMEOUT_SECONDS=120
