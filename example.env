# Main LLM profile. Deep Agents accepts LangChain chat model instances, so the
# runtime builds ChatOpenAI from this profile for OpenAI-compatible providers.
LLM_ACTIVE_PROFILE=deepseek_v4_flash

LLM_PROFILE_DEEPSEEK_V4_FLASH_PROVIDER=deepseek
LLM_PROFILE_DEEPSEEK_V4_FLASH_API_KEY=your-deepseek-api-key
LLM_PROFILE_DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash
LLM_PROFILE_DEEPSEEK_V4_FLASH_API_BASE_URL=https://api.deepseek.com/v1

LLM_PROFILE_OPENAI_GPT5_PROVIDER=openai
LLM_PROFILE_OPENAI_GPT5_API_KEY=your-openai-api-key
LLM_PROFILE_OPENAI_GPT5_MODEL=gpt-5
LLM_PROFILE_OPENAI_GPT5_API_BASE_URL=https://api.openai.com/v1

# Legacy fallback when LLM_ACTIVE_PROFILE is empty.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE_URL=

# Retrieval can use a separate cheaper model. Empty values fall back to main LLM.
RETRIEVAL_LLM_ACTIVE_PROFILE=
RETRIEVAL_LLM_PROVIDER=
RETRIEVAL_LLM_API_KEY=
RETRIEVAL_LLM_MODEL=
RETRIEVAL_LLM_API_BASE_URL=

# Domain data.
BLASTFOAM_TUTORIALS=/data/graduation-projects/blastFoam_tutorials

# Execution controls.
ENABLE_EXECUTION=false
REQUIRE_EXECUTION=false
ALLOW_ROOT_OPENFOAM=false
OPENFOAM_EXECUTION_USER=openfoam
OPENFOAM_CHOWN_CASE=true
OPENFOAM_BASHRC=/data/OpenFOAM/OpenFOAM-9/etc/bashrc
BLASTFOAM_BASHRC=/data/OpenFOAM/blastfoam/etc/bashrc

# Agent controls.
DEEPAGENTS_RECURSION_LIMIT=200
MCP_RETRIEVAL_TIMEOUT_SECONDS=120
MCP_RETRIEVAL_STARTUP_TIMEOUT_SECONDS=120
